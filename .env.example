# Copy to .env.local and fill in. Never commit .env.local.

# --- Database (Supabase Postgres, used via Drizzle) ---
# Connection string from Supabase: Project Settings > Database > Connection string (URI)
DATABASE_URL=

# --- Clerk (authentication) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Signing secret from the Clerk dashboard webhook (whsec_...)
CLERK_WEBHOOK_SECRET=

# --- Supabase JS client (optional; only if the supabase-js stub is wired up) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Not yet enabled (stubs only) ---
# Payments/escrow (later)
STRIPE_SECRET_KEY=
# Transactional email (later)
RESEND_API_KEY=
# Analytics (later)
NEXT_PUBLIC_POSTHOG_KEY=
