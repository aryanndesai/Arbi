# Arbi environment variables
# Copy this file to .env.local and fill in real values. Never commit .env.local.

# --- Database (required) ---
# Postgres connection string (Supabase hosts the DB; the app talks to it via
# Drizzle + postgres-js, not the Supabase JS client).
DATABASE_URL=

# --- Clerk auth (required) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Signing secret from the Clerk dashboard webhook. Subscribe the endpoint
# (/api/webhooks/clerk) to user.created, user.updated, user.deleted.
CLERK_WEBHOOK_SECRET=

# --- Supabase (optional; currently unused stub in lib/supabase.ts) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Later features (stubs only today) ---
# Stripe Connect escrow (lib/stripe.ts)
STRIPE_SECRET_KEY=
# Resend transactional email (lib/resend.ts)
RESEND_API_KEY=
# PostHog analytics (lib/posthog.ts)
NEXT_PUBLIC_POSTHOG_KEY=
