# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real secrets.

# --- Database (required — app will not boot without this) ---
# Postgres connection string. In production this is the Supabase
# "Connection string" (Transaction or Session pooler) for the postgres user.
DATABASE_URL=

# --- Clerk auth (required) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# From the Clerk dashboard: Configure > Webhooks > (endpoint) > Signing Secret
CLERK_WEBHOOK_SECRET=

# --- Supabase JS client (stub today — not used by real queries yet) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Deferred services (stubs only, safe to leave blank for now) ---
STRIPE_SECRET_KEY=
RESEND_API_KEY=
NEXT_PUBLIC_POSTHOG_KEY=
